{
  "preset_id": "policy/internal_rto_mandate",
  "description": "Internal return-to-office mandate with dissent tiered by seniority and tenure. Trips H-RETENTION, H-DISSENT, H-COMPLIANCE.",
  "persona": "policy",
  "scope": "internal_org",
  "region": "US",
  "expected_risk_tags": [
    "H-RETENTION",
    "H-DISSENT",
    "H-COMPLIANCE"
  ],
  "preset_overrides": {
    "scenario": {
      "topic": "Mandatory 4-day-per-week return to office, effective in 90 days",
      "drift_horizon_rounds": 10,
      "run": {
        "ensemble_n": 5,
        "tier": "sanity"
      },
      "domain_context": {
        "policy_state": {
          "enforcement_mechanism": "badge_swipe_audit",
          "grace_period_days": 90,
          "exception_path": "manager_discretion"
        },
        "org_state": {
          "headcount_band": "5000-10000",
          "remote_share_pre_mandate": 0.55
        }
      },
      "assumptions": [
        "Mandate is communicated company-wide on day 0 with no phased rollout.",
        "Exception requests route through line managers with no central tracking.",
        "External job market remains absorbent for senior ICs over the horizon."
      ],
      "success_criteria": [
        "Senior IC voluntary attrition delta <= 0.05 over the horizon.",
        "Compliance rate >= 0.80 by day 90 across all cohorts.",
        "No Glassdoor rating drop greater than 0.5 stars."
      ],
      "failure_modes_to_watch": [
        "Senior ICs depart silently before the badge-swipe enforcement begins.",
        "Manager-discretion exception path becomes the de-facto policy, undermining the mandate.",
        "Junior cohort compliance masks a hidden engagement collapse."
      ],
