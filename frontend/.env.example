# Frontend build-time variables (read by Vite; only VITE_ prefixed vars are exposed to the client bundle)
# Local frontend build: copy to frontend/.env and fill in. For Docker builds, docker compose injects values via build-arg (see VITE_API_KEY in the root .env).

# Must match the backend .env API_KEY -- the bundled UI uses it as X-API-Key when calling /api/*.
# Warning: this gets baked into the client bundle and can be extracted by any visitor. Do not rely on it for multi-tenant isolation (see README security notes).
VITE_API_KEY=

# Backend API base URL (defaults to the frontend preview/dev server's /api proxy to the backend; set a full URL here to hit the backend directly)
# VITE_API_BASE_URL=http://localhost:5001
